# Copy to .env and adjust. Never commit .env.

# ------------------------------------------------------------- Postgres ----
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
POSTGRES_HOST=localhost
# Host port for the container. project1 uses 5434 and project2 uses 5435, so
# this stack takes 5436 to stay out of the way.
POSTGRES_PORT=5436

# ---------------------------------------------------------------- Kafka ----
# Host-side bootstrap server. Inside the compose network the broker is
# reachable as kafka:9092; from the host it is localhost:9096.
KAFKA_BOOTSTRAP_SERVERS=localhost:9096
KAFKA_PORT=9096
KAFKA_TOPIC=fleet.telemetry
KAFKA_CONSUMER_GROUP=fleet-stream-processor

# Partition count for the telemetry topic. Pings are keyed by vehicle_id, so
# one vehicle's pings always land on one partition and stay in order -- which
# is what makes the per-vehicle state machine in fleet/detector.py correct
# rather than approximate.
KAFKA_TOPIC_PARTITIONS=12

# ------------------------------------------------------------- Consumer ----
# Pings buffered before one COPY into raw.pings. The whole batch -- pings,
# detections and the updated vehicle state -- is written in one transaction,
# and Kafka offsets are committed only after that transaction commits.
CONSUMER_BATCH_SIZE=500
# Flush a partial batch after this many seconds so a quiet stream still lands.
CONSUMER_BATCH_TIMEOUT_SECONDS=5.0
# Stop after this many seconds with no new messages. 0 = run until Ctrl-C.
CONSUMER_IDLE_TIMEOUT_SECONDS=0

# ------------------------------------------------------------ Detection ----
# A vehicle is "stopped" below this speed. Set from GPS noise, not from zero:
# a parked vehicle still reports 1-3 kph of jitter.
IDLE_SPEED_KPH=3.0
# ...and it must stay stopped this long before the stop counts as idle time.
IDLE_MINUTES=5
# Metres from the assigned route before a vehicle counts as off-route. 120 m
# clears normal GPS error and a parallel service road; 50 m would alert on
# every overpass.
DEVIATION_METRES=120
# ...sustained for this long. A single deviating ping is noise.
DEVIATION_SECONDS=90
# Schedule slip that opens a delay alert, and the extra slip needed before an
# already-open delay is re-reported (so one late trip is not 200 alerts).
DELAY_MINUTES=10
DELAY_RESTEP_MINUTES=10
# A gap longer than this is treated as lost signal, not as standing still.
# Idle runs and route deviations are closed rather than extended across it.
GPS_GAP_MINUTES=10

# ---------------------------------------------------------- Geospatial ----
# H3 resolutions stored on every ping. r8 (~0.7 km edge) drives the map
# heatmap; r9 (~0.26 km edge) is there for finer slicing without a re-ingest.
H3_RESOLUTION_COARSE=8
H3_RESOLUTION_FINE=9

# ------------------------------------------------------------ Warehouse ----
# Directory holding the dbt-style SQL models.
MODELS_DIR=models

# ------------------------------------------------------------ Simulator ----
# Fleet reference data: vehicles, geofence zones and routes.
FLEET_CONFIG_FILE=config/fleet.json
# Seconds between pings from a moving vehicle.
PING_INTERVAL_SECONDS=15
# Seed for the simulator. Set to an integer for a reproducible stream.
SIMULATOR_SEED=
